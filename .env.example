# PropAgent AI — Environment Variables
# Copy this to .env and fill in real values

# ── Core ──
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_SECRET=jwt-secret-change-me-generate-with-openssl-rand-hex-32
DEBUG=false

# ── Database ──
DATABASE_URL=postgresql://propagent:propagent@localhost:5432/propagent

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── OpenAI ──
OPENAI_API_KEY=sk-...

# ── Stripe ──
STRIPE_SECRET=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# ── Twilio (Voice AI) ──
TWILIO_SID=AC...
TWILIO_TOKEN=...
TWILIO_PHONE=+1...

# ── Email (SendGrid) ──
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG....
FROM_EMAIL=noreply@propagent.ai

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
